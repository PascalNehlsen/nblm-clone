{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubInfraEnvironment",
      "Effect": "Allow",
      "Principal": {
        "Federated": "${oidc_provider_arn}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:PascalNehlsen@164803589/nblm-clone@1421836505:environment:infra"
        }
      }
    }
  ]
}
