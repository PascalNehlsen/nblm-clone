# Copy the names you need into a gitignored file (.env.local, supabase/.env) or your shell.
# Values are never committed.

# GitHub OAuth app for local Supabase Auth (supabase/config.toml reads them via env()).
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Web app (apps/web/.env.local). URL and publishable key from `pnpm exec supabase status`
# (API_URL, PUBLISHABLE_KEY); never the secret key here, the app refuses it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server only, read by the model-call wrapper (ADR 0006). Without them every model call
# fails closed. The secret key is set by a human in Vercel develop and production, never
# in Preview and never in the sandbox.
SUPABASE_SECRET_KEY=
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
