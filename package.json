{
  "name": "nblm-clone",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "pnpm --filter web typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "build": "pnpm --filter web build",
    "test:rls": "vitest run --project rls",
    "test:e2e": "playwright test",
    "test:db": "supabase test db --local",
    "db:start": "supabase start",
    "db:stop": "supabase stop"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.80",
    "@playwright/test": "1.64.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/functions": "3.10.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "unpdf": "1.9.0",
    "vercel": "62.2.0",
    "vitest": "5.0.5"
  }
}
